# =============================================================================
# GIG — Moda Feminina — Modelo do .env
# Copie:  cp .env.example .env
# NÃO coloque senhas reais neste arquivo.
# =============================================================================

# --- BANCO (Supabase Session pooler) ---
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUA_SENHA_DO_BANCO
DB_SSL_MODE=require
DB_POOL_SIZE=5

# --- SERVIDOR ---
# development | production  (em production: Swagger desliga e exige JWT/MP fortes)
APP_ENV=development
SERVER_PORT=8080
FRONTEND_PORT=5173
UPLOAD_DIR=uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=

# --- SEGURANÇA ---
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-64-caracteres
JWT_EXPIRATION_MS=86400000

# --- ADMIN ---
ADMIN_NAME=GIG — Moda Feminina
ADMIN_EMAIL=seu-email@gmail.com
ADMIN_PASSWORD=defina-uma-senha-forte
ADMIN_RESET_PASSWORD=false

# --- MERCADO PAGO ---
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Obrigatória em production (painel MP → Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SUCCESS_URL=http://localhost:5173/checkout/sucesso
MERCADOPAGO_FAILURE_URL=http://localhost:5173/checkout/falha
MERCADOPAGO_PENDING_URL=http://localhost:5173/checkout/pendente

# --- E-MAIL ---
# Gmail: use Senha de app (não a senha da conta). https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=
MAIL_FROM=GIG — Moda Feminina <seu-email@gmail.com>

# --- GOOGLE LOGIN ---
GOOGLE_CLIENT_ID=

# --- FRETE / PEDIDOS ---
SHIPPING_ORIGIN_CEP=01310100
SHIPPING_WEIGHT_PER_ITEM_KG=0.35
ORDER_PAYMENT_EXPIRATION_HOURS=24
