# =============================================================================
# GIG — Moda Feminina — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atelie_gg
DB_USER=postgres
DB_PASSWORD=postgres

# --- Backend ---
SERVER_PORT=8080

# Chave secreta JWT (mínimo 32 caracteres — gere uma aleatória forte)
JWT_SECRET=altere-esta-chave-para-uma-string-longa-e-aleatoria-com-pelo-menos-64-caracteres
JWT_EXPIRATION_MS=86400000

# Origens permitidas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Pasta de upload de imagens no servidor
UPLOAD_DIR=uploads

# --- Mercado Pago ---
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_PUBLIC_KEY=SEU_PUBLIC_KEY_AQUI
MERCADOPAGO_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI
MERCADOPAGO_CLIENT_ID=SEU_CLIENT_ID_AQUI
MERCADOPAGO_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI
MERCADOPAGO_WEBHOOK_SECRET=

# URLs de retorno após pagamento (ajuste em produção)
MERCADOPAGO_SUCCESS_URL=http://localhost:5173/checkout/sucesso
MERCADOPAGO_FAILURE_URL=http://localhost:5173/checkout/falha
MERCADOPAGO_PENDING_URL=http://localhost:5173/checkout/pendente

# --- Email (recuperação de senha) ---
# Para Gmail: use uma "Senha de app" em https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=SUA_SENHA_DE_APP_AQUI
MAIL_FROM=GIG — Moda Feminina <seu-email@gmail.com>

# --- Pedidos ---
# Pagamentos não finalizados são cancelados automaticamente após este prazo (horas)
ORDER_PAYMENT_EXPIRATION_HOURS=24

# --- Frete (Correios) ---
# CEP de origem da loja (onde as encomendas serão postadas)
SHIPPING_ORIGIN_CEP=01310100
# Peso médio estimado por peça (kg) para simulação
SHIPPING_WEIGHT_PER_ITEM_KG=0.35
# A API legada dos Correios está instável; deixe false (padrão) para cotação rápida por CEP/UF
# SHIPPING_TRY_LEGACY_API=false

# --- Administrador inicial ---
ADMIN_NAME=GIG — Moda Feminina
ADMIN_EMAIL=atelie.gig@gmail.com
ADMIN_PASSWORD=defina-uma-senha-forte-aqui
ADMIN_RESET_PASSWORD=false

# --- Google Login (OAuth Web Client ID) ---
# Crie em: https://console.cloud.google.com/apis/credentials
# Tipo: "ID do cliente OAuth" → Aplicativo da Web
# Origins autorizados: http://localhost:5173
# redirect URIs não são necessários para o fluxo GIS (botão ID token)
GOOGLE_CLIENT_ID=

# --- Frontend (usado no build Docker) ---
# Deixe vazio no Docker para usar proxy Nginx; use http://localhost:8080 em dev local
VITE_API_URL=http://localhost:8080
